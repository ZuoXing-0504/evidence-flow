APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=evidence-flow

POSTGRES_DB=evidence_flow
POSTGRES_USER=evidence_flow
POSTGRES_PASSWORD=evidence_flow
DATABASE_URL=postgresql+asyncpg://evidence_flow:evidence_flow@postgres:5432/evidence_flow
REDIS_URL=redis://redis:6379/0

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=evidence_flow
VECTOR_STORE_PROVIDER=milvus

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_PROVIDER=mock
LLM_REASONING_MODEL=qwen-plus
LLM_FAST_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
EMBEDDING_PROVIDER=mock

BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1
WEB_SEARCH_PROVIDER=mock
BOCHA_RESULTS_PER_QUERY=5
PROVIDER_TIMEOUT_SECONDS=30
MAX_RESEARCH_ITERATIONS=2
MAX_DOCUMENT_UPLOAD_BYTES=10485760

